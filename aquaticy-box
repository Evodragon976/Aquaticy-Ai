#!/usr/bin/env bash









set -euo pipefail

cd "$(dirname "$0")"
mkdir -p exports
COMPOSE=(docker compose)



if [[ "$(uname -s)" == "Linux" ]]; then
    AQUATICY_UID="$(id -u)"
    AQUATICY_GID="$(id -g)"
    export AQUATICY_UID AQUATICY_GID
fi




if [[ "${1:-}" == "--lan" ]]; then
    shift
    COMPOSE+=(-f compose.yaml -f compose.host.yaml)
fi

case "${1:-}" in
    --build)
        shift
        "${COMPOSE[@]}" build aquaticy
        ;;
    --setup)


        "${COMPOSE[@]}" run --rm aquaticy setup --env-file /work/.env
        if [[ -f exports/.env ]]; then
            mv exports/.env .env
            echo "Konfiguration gespeichert in $(pwd)/.env"
        fi
        exit 0
        ;;
esac

if [[ ! -f .env ]]; then
    echo "Keine .env gefunden -- richte aquaticy einmalig ein:" >&2
    echo "  ./aquaticy-box --setup" >&2
    exit 1
fi



if ! grep -q '^SEARXNG_SECRET=.' .env; then
    geheim="$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')"
    printf '\nSEARXNG_SECRET=%s\n' "$geheim" >> .env
fi

exec "${COMPOSE[@]}" run --rm aquaticy "$@"
